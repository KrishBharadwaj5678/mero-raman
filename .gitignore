node_modules/
jspm_packages/
web_modules/

# ==========================================
# TypeScript / Build Outputs
# ==========================================
# Common build folders
dist/
build/
out/
/built

# TypeScript incremental build cache
*.tsbuildinfo

# (Optional) If your build step outputs JS next to TS files in /src, 
# you may want to uncomment the line below to ignore them.
# src/**/*.js

# ==========================================
# Logs and Diagnostics
# ==========================================
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# Testing & Coverage
# ==========================================
coverage/
.nyc_output/
.jest/

# ==========================================
# Environment Variables & Secrets
# ==========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Do NOT ignore the example template if you use one
!.env.example

# ==========================================
